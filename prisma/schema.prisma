// ============================================================
//  Prisma Schema — SaaS School Custom Paper Generator
//  Database: Neon Serverless PostgreSQL
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // directUrl is required by Neon for Prisma migrations (bypasses the pooler)
  directUrl = env("DIRECT_URL")
}

// ============================================================
//  ENUMS
// ============================================================

enum UserRole {
  SUPER_ADMIN // Platform owner
  SCHOOL_ADMIN // Admin of a tenant school
  TEACHER // Creates/manages papers
  STUDENT // (future) views assigned papers
}

enum PlanTier {
  FREE
  STARTER
  PRO
  ENTERPRISE
}

enum PaperStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}enum QuestionType {
  MCQ             // Multiple Choice
  SHORT_ANSWER
  LONG_ANSWER
  TRUE_FALSE
  FILL_IN_THE_BLANK
  MATCH_THE_FOLLOWING
  CASE_STUDY      // Passage-based analytical question
}

enum DifficultyLevel {
  EASY
  MEDIUM
  HARD
}

enum BloomLevel {
  REMEMBER
  UNDERSTAND
  APPLY
  ANALYZE
  EVALUATE
  CREATE
}

enum CaseStudyFormat {
  INLINE
  SHARED_PASSAGE
}

enum Medium {
  ENGLISH
  GUJARATI
}

enum ImportStatus {
  PENDING
  PARTIAL
  COMPLETED
  FAILED
}

enum PaperGenerationMode {
  MANUAL     // Teacher selects questions manually
  BLUEPRINT  // System auto-picks based on rules
}

// ============================================================
//  PHASE 4 — Assignments & Submissions
// ============================================================

enum AssignmentType {
  EXAM       // Timed online exam
  HOMEWORK   // Take-home assignment
}

enum AssignmentStatus {
  SCHEDULED  // Not yet active
  ACTIVE     // Currently available
  CLOSED     // Past end time
}

enum SubmissionStatus {
  NOT_STARTED
  IN_PROGRESS
  SUBMITTED
  AUTO_SUBMITTED  // Timer expired
}

model QuestionImport {
  id           String       @id @default(cuid())
  fileName     String
  status       ImportStatus @default(PENDING)
  totalCount   Int          @default(0)
  successCount Int          @default(0)
  failedCount  Int          @default(0)
  errors       Json // [{ row, questionPreview, error }]
  createdAt    DateTime     @default(now())

  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  userId   String
  user     User   @relation(fields: [userId], references: [id])

  @@index([schoolId, createdAt])
  @@index([userId])
  @@map("question_imports")
}

// ============================================================
//  TENANT (School)
// ============================================================

model School {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique // used as subdomain / tenant identifier
  logoUrl   String?
  address   String?
  phone     String?
  website   String?
  planTier  PlanTier @default(FREE)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  users         User[]
  classLevels   ClassLevel[]
  subjects      Subject[]
  papers        Paper[]
  questionBank  Question[]
  imports       QuestionImport[]
  subscription  Subscription?
  assignments   PaperAssignment[]

  @@map("schools")
}

// ============================================================
//  USER
// ============================================================

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  passwordHash  String?
  avatarUrl     String?
  role          UserRole  @default(TEACHER)
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Multi-tenant FK
  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  // Student: which class they belong to
  classLevelId String?
  classLevel   ClassLevel? @relation("ClassStudents", fields: [classLevelId], references: [id], onDelete: SetNull)

  // Relations
  papers            Paper[]
  imports           QuestionImport[]
  accounts          Account[]
  sessions          Session[]
  createdAssignments PaperAssignment[]   @relation("AssignmentCreator")
  submissions       StudentSubmission[]
  gradedAnswers     Answer[]             @relation("GradedAnswers")

  @@index([schoolId])
  @@index([classLevelId])
  @@index([schoolId, role])
  @@map("users")
}

// ============================================================
//  AUTH (NextAuth / Auth.js compatible tables)
// ============================================================

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ============================================================
//  CURRICULUM TAXONOMY — CLASS → SUBJECT → CHAPTER → TOPIC
// ============================================================

model ClassLevel {
  id        String   @id @default(cuid())
  name      String // e.g., "Std 6" … "Std 12"
  order     Int      @default(0) // sort order (6 → 12)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  subjects    Subject[]
  students    User[]            @relation("ClassStudents")
  assignments PaperAssignment[]

  @@unique([schoolId, name])
  @@index([schoolId])
  @@map("class_levels")
}

model Subject {
  id        String   @id @default(cuid())
  name      String
  code      String?
  medium    Medium   @default(ENGLISH)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  schoolId     String
  school       School     @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  classLevelId String
  classLevel   ClassLevel @relation(fields: [classLevelId], references: [id], onDelete: Cascade)

  chapters  Chapter[]
  questions Question[]
  papers    Paper[]

  @@unique([classLevelId, name, medium])
  @@index([schoolId])
  @@index([classLevelId])
  @@map("subjects")
}

model Chapter {
  id        String   @id @default(cuid())
  name      String
  order     Int      @default(0)
  medium    Medium   @default(ENGLISH)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subjectId String
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  topics    Topic[]
  questions Question[]

  @@unique([subjectId, name])
  @@index([subjectId])
  @@map("chapters")
}

model Topic {
  id        String   @id @default(cuid())
  name      String
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  chapterId String
  chapter   Chapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  questions Question[]

  @@unique([chapterId, name])
  @@index([chapterId])
  @@map("topics")
}

// ============================================================
//  QUESTION BANK
// ============================================================

model Question {
  id           String          @id @default(cuid())
  code         String          @unique // 6-digit human-friendly ID (e.g. 483920)
  questionText String          @db.Text
  questionType QuestionType
  difficulty   DifficultyLevel @default(MEDIUM)
  medium       Medium          @default(ENGLISH)
  marks        Float           @default(1)
  options      Json? // For MCQ: [{ "label": "A", "text": "...", "isCorrect": true }]
  answerKey    String?         @db.Text
  explanation  String?         @db.Text
  tags         String[] // Array of tag strings
  imageUrl     String?
  isActive     Boolean         @default(true)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  // Tenant FK
  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  subjectId String
  subject   Subject @relation(fields: [subjectId], references: [id])

  chapterId String?
  chapter   Chapter? @relation(fields: [chapterId], references: [id])

  // Taxonomy (topic optional — chapter fallback)
  topicId String?
  topic   Topic?  @relation(fields: [topicId], references: [id])

  // Pedagogy metadata
  bloomLevel      BloomLevel?
  caseStudyFormat CaseStudyFormat? // for CASE_STUDY questions
  previousYearTag String? // e.g., "GSEB 2023", "Board 2024"

  // Many-to-many with Papers via join table
  paperSections PaperSectionQuestion[]
  answers       Answer[]

  @@index([schoolId])
  @@index([subjectId])
  @@index([chapterId])
  @@index([topicId])
  @@index([previousYearTag])
  @@map("questions")
}

// ============================================================
//  PAPER (Exam Paper)
// ============================================================

model Paper {
  id           String      @id @default(cuid())
  title        String
  description  String?
  totalMarks   Float       @default(0)
  passingMarks Float?      // minimum passing marks
  duration     Int?        // in minutes
  instructions String?     @db.Text
  status       PaperStatus @default(DRAFT)
  publishedAt  DateTime?
  pdfUrl       String?     // link to generated PDF
  answerKeyPdfUrl String?  // link to generated answer key PDF

  // Generation mode
  generationMode PaperGenerationMode @default(MANUAL)

  // School header customization
  schoolHeader String?  @db.Text  // custom school header text for PDF
  watermarkText String?           // watermark text for the PDF

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Tenant FK
  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  subjectId String?
  subject   Subject? @relation(fields: [subjectId], references: [id])

  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id])

  sections     PaperSection[]
  assignments PaperAssignment[]

  @@index([schoolId])
  @@index([subjectId])
  @@index([createdById])
  @@map("papers")
}

// ============================================================
//  PAPER SECTION  (e.g., Section A — MCQ, Section B — Long Answer)
// ============================================================

model PaperSection {
  id           String  @id @default(cuid())
  title        String // e.g., "Section A"
  instructions String?
  order        Int     @default(0)
  totalMarks   Float   @default(0)

  paperId String
  paper   Paper  @relation(fields: [paperId], references: [id], onDelete: Cascade)

  questions PaperSectionQuestion[]

  @@index([paperId])
  @@map("paper_sections")
}

// ============================================================
//  JOIN TABLE — Paper Section ↔ Questions
// ============================================================

model PaperSectionQuestion {
  id            String @id @default(cuid())
  order         Int    @default(0)
  marksOverride Float? // override question's default marks in this paper

  sectionId String
  section   PaperSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([sectionId, questionId])
  @@index([sectionId])
  @@index([questionId])
  @@map("paper_section_questions")
}

// ============================================================
//  SUBSCRIPTION (Billing / Plan Management)
// ============================================================

model Subscription {
  id                   String    @id @default(cuid())
  stripeCustomerId     String?   @unique
  stripeSubscriptionId String?   @unique
  stripePriceId        String?
  planTier             PlanTier  @default(FREE)
  status               String    @default("active") // active | canceled | past_due
  currentPeriodStart   DateTime?
  currentPeriodEnd     DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  schoolId String @unique
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@map("subscriptions")
}

// ============================================================
//  PHASE 4 — Paper Assignment
// ============================================================

model PaperAssignment {
  id          String           @id @default(cuid())
  title       String
  type        AssignmentType   @default(EXAM)
  status      AssignmentStatus @default(SCHEDULED)
  startTime   DateTime
  endTime     DateTime
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  paperId String
  paper   Paper  @relation(fields: [paperId], references: [id], onDelete: Cascade)

  classLevelId String
  classLevel   ClassLevel @relation(fields: [classLevelId], references: [id], onDelete: Cascade)

  createdById String
  createdBy   User @relation("AssignmentCreator", fields: [createdById], references: [id])

  submissions StudentSubmission[]

  @@index([schoolId])
  @@index([paperId])
  @@index([classLevelId])
  @@index([createdById])
  @@map("paper_assignments")
}

// ============================================================
//  PHASE 4 — Student Submission
// ============================================================

model StudentSubmission {
  id          String           @id @default(cuid())
  startedAt   DateTime?
  submittedAt DateTime?
  status      SubmissionStatus @default(NOT_STARTED)
  totalScore  Float?
  gradedAt    DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  assignmentId String
  assignment   PaperAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  studentId String
  student   User @relation(fields: [studentId], references: [id], onDelete: Cascade)

  answers Answer[]

  @@unique([assignmentId, studentId])
  @@index([assignmentId])
  @@index([studentId])
  @@map("student_submissions")
}

// ============================================================
//  PHASE 4 — Answer
// ============================================================

model Answer {
  id             String   @id @default(cuid())
  answerText     String?  @db.Text
  selectedOption String?
  awardedMarks   Float?
  graderComment  String?  @db.Text
  gradedAt       DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  submissionId String
  submission   StudentSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  graderId String?
  grader   User? @relation("GradedAnswers", fields: [graderId], references: [id], onDelete: SetNull)

  @@unique([submissionId, questionId])
  @@index([submissionId])
  @@index([questionId])
  @@index([graderId])
  @@map("answers")
}
